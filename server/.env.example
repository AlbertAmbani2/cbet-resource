# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection
# Replace the password with your local PostgreSQL password.
# URL-encode special characters (for example @ becomes %40).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbet_resource

# Set this only when using a managed/remote PostgreSQL provider that requires SSL
# (for example Neon). Leave unset for local PostgreSQL.
# PGSSLMODE=require

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173
